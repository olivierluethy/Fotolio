{
    "name": "fotolio/api",
    "description": "Fotolio API and public site renderer — photo portfolio SaaS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-exif": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10",
        "intervention/image": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Fotolio\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "serve": "php -S 0.0.0.0:8000 -t public"
    }
}
