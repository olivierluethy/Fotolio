{
    "name": "fotolio/api",
    "description": "Fotolio API and public site renderer — photo portfolio SaaS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-exif": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10",
        "intervention/image": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Fotolio\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "serve": "php -d upload_max_filesize=64M -d post_max_size=80M -d memory_limit=512M -d max_file_uploads=100 -S 127.0.0.1:8000 -t public public/index.php"
    }
}
