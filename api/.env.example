# ---- Application ----------------------------------------------------------
APP_NAME=Fotolio
APP_ENV=local                 # local | production
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated hosts that serve the platform (landing/dashboard/API) rather
# than a published user site. Everything else is resolved as a user site.
PLATFORM_HOSTS=localhost,127.0.0.1,localhost:8000,127.0.0.1:8000
# Base domain used to build subdomain + custom-domain instructions, e.g. fotolio.app
PLATFORM_BASE_DOMAIN=localhost
# Where the built dashboard SPA lives (production). In local dev the SPA runs on Vite.
DASHBOARD_URL=http://localhost:5173

# ---- Database -------------------------------------------------------------
# DB_DRIVER=mysql | sqlite
# Local dev defaults to zero-config SQLite. Production uses MySQL/MariaDB.
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/fotolio.sqlite
# --- MySQL / MariaDB (production) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fotolio
DB_USER=fotolio
DB_PASS=

# ---- Auth / JWT -----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
REFRESH_COOKIE_NAME=fotolio_rt
REFRESH_COOKIE_SECURE=false   # true in production (HTTPS)

# ---- Media / uploads ------------------------------------------------------
MEDIA_URL=/media              # public base path for optimised variants
UPLOAD_MAX_MB=40
# Reference bandwidth (Mbps) for estimated load-time delta in the before/after UI
REFERENCE_BANDWIDTH_MBPS=5

# ---- OAuth (stubs — buttons present, endpoints return "not configured") ---
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
APPLE_CLIENT_ID=

# ---- Analytics / GeoIP ----------------------------------------------------
# Self-hosted GeoLite2 (Country or City) .mmdb — resolves visitor country and,
# with a City DB, precise coordinates. Absent => country "Unknown". See docs.
GEOLITE2_DB=storage/GeoLite2-Country.mmdb
ANALYTICS_ACTIVE_WINDOW=300   # "active now" window, seconds
# Demo geolocation: plot loopback/private (and any non-production) visits at a
# demo coordinate so the globe works on localhost. Defaults on unless
# APP_ENV=production. Real public IPs in production resolve normally.
ANALYTICS_DEMO_GEO=           # blank = auto (on unless production); true|false to force
ANALYTICS_DEMO_LAT=47.0502    # Lucerne, CH
ANALYTICS_DEMO_LNG=8.3093
ANALYTICS_DEMO_COUNTRY=Switzerland
ANALYTICS_DEMO_CC=CH
